<%@ Page Async="true" Title="Site settings" Language="C#" MasterPageFile="~/CoordinatorPages/Section.Master" AutoEventWireup="true" CodeBehind="Settings.aspx.cs" Inherits="Yarmouk.CoordinatorPages.Settings" %>
<asp:Content ID="SettingsHead" ContentPlaceHolderID="HeadContent" runat="server">
<link href="<%= ResolveUrl("~/Content/CoordinatorPages/Settings.css?v=16") %>" rel="stylesheet" />
<script src="<%= ResolveUrl("~/Scripts/CoordinatorPages/Settings.js?v=16") %>" defer></script>
</asp:Content>
<asp:Content ID="SettingsBody" ContentPlaceHolderID="MainContent" runat="server">
<script type="application/json" id="backend-data"><%= BackendJson %></script>
<main class="site-settings-page" data-site-settings-page data-default-favicon="<%= ResolveUrl("~/assets/yarmouk-mark.svg") %>" aria-labelledby="settings-title">
  <header class="settings-hero"><div><p class="settings-eyebrow">COORDINATOR WORKSPACE</p><h1 id="settings-title">Site settings</h1><p>Manage the university identity, default appearance, homepage metadata, and subscription plan.</p></div><span class="settings-lock">Coordinator only</span></header>
  <p class="settings-feedback" data-settings-feedback role="status" aria-live="polite"></p>
  <div class="settings-form" data-settings-form>
    <nav class="settings-tabs" role="tablist" aria-label="Site settings sections">
      <button type="button" class="settings-tab is-active" id="settings-tab-appearance" role="tab" aria-selected="true" aria-controls="settings-panel-appearance" tabindex="0" data-settings-tab="appearance"><span class="settings-tab-index">01</span><span><strong>Brand & appearance</strong><small>Logo, font, default theme</small></span></button>
      <button type="button" class="settings-tab" id="settings-tab-homepage" role="tab" aria-selected="false" aria-controls="settings-panel-homepage" tabindex="-1" data-settings-tab="homepage"><span class="settings-tab-index">02</span><span><strong>Homepage & integrations</strong><small>Metadata, database, plugins</small></span></button>
      <button type="button" class="settings-tab" id="settings-tab-subscription" role="tab" aria-selected="false" aria-controls="settings-panel-subscription" tabindex="-1" data-settings-tab="subscription"><span class="settings-tab-index">03</span><span><strong>Plans</strong><small>Compare and choose a plan</small></span></button>
    </nav>
    <input type="hidden" name="adminCsrf" value="<%= CsrfToken %>" />
    <input type="hidden" name="adminAction" value="" />
    <input type="hidden" name="adminPayload" value="" />
    <section class="settings-panel settings-tab-panel" id="settings-panel-appearance" role="tabpanel" aria-labelledby="settings-tab-appearance" tabindex="0"><header><div><p class="settings-eyebrow">BRAND & APPEARANCE</p><h2 id="appearance-heading">Website identity</h2><p>These choices become the default across the site. People can still switch their own display mode.</p></div></header>
      <div class="settings-grid">
        <label class="settings-field"><span>Default appearance</span><select name="defaultTheme"><option value="light">Light</option><option value="dark">Dark</option></select><small>Used when a visitor has not chosen a theme on this device.</small></label>
        <label class="settings-field"><span>Site font</span><select name="fontFamily"><option>DM Sans</option><option>Inter</option><option>system-ui</option><option>Arial</option><option>Georgia</option></select><small>Uses locally available/system fonts, so pages remain fast and readable.</small></label>
        <div class="settings-field settings-logo-field"><span>University logo</span><div class="settings-logo-editor"><div class="settings-logo-preview" data-logo-preview><img alt="Preview of the current website logo" /><span data-logo-status>Current website logo</span></div><label class="settings-upload-dropzone" data-logo-dropzone><input type="file" name="logoFile" accept="image/png,image/jpeg,image/webp" /><span class="settings-upload-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="settings-upload-copy"><strong>Choose a new logo</strong><small>or drag and drop an image here</small></span><span class="settings-upload-types">PNG · JPG · WEBP<br />Maximum 1 MB</span></label><small class="settings-logo-help">Your current logo is shown above. A selected image is previewed here and on the site header before you save.</small></div></div>
        <div class="settings-field settings-favicon-field"><span>Favicon and compact sidebar icon</span><div class="settings-logo-editor"><div class="settings-favicon-preview" data-favicon-preview><img alt="Preview of the current favicon" /><span data-favicon-status>Current favicon</span></div><label class="settings-upload-dropzone" data-favicon-dropzone><input type="file" name="faviconFile" accept="image/png,.ico,image/x-icon,image/vnd.microsoft.icon" /><span class="settings-upload-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="settings-upload-copy"><strong>Choose a favicon</strong><small>or drag and drop an image here</small></span><span class="settings-upload-types">PNG · ICO<br />Auto-optimized · source up to 10 MB</span></label><small class="settings-logo-help">The image is optimized as a small PNG before preview and save. It updates the browser tab and compact sidebar icon.</small></div></div>
      </div>
    </section>
    <section class="settings-panel settings-tab-panel" id="settings-panel-homepage" role="tabpanel" aria-labelledby="settings-tab-homepage" tabindex="0" hidden><header><div><p class="settings-eyebrow">SEARCH & INTEGRATIONS</p><h2 id="homepage-heading">Homepage and plugins</h2><p>Homepage title and metadata are applied to the public homepage. Plugin snippets are optional.</p></div></header>
      <div class="settings-grid"><label class="settings-field settings-wide"><span>Homepage title</span><input name="homeTitle" maxlength="120" /></label>
        <label class="settings-field settings-wide"><span>Meta description</span><textarea name="homeDescription" rows="3" maxlength="320"></textarea></label>
        <label class="settings-field settings-wide"><span>Meta keywords</span><input name="metaKeywords" maxlength="240" /><small>Separate terms with commas.</small></label>
        <label class="settings-field settings-wide"><span>Firebase Realtime Database URL</span><input name="firebaseDatabaseUrl" type="url" maxlength="320" placeholder="https://your-project-default-rtdb.firebaseio.com" /><small>Updates the server-side database connection for all site pages. API keys stay in server configuration; the Firebase Authentication key must belong to the same project.</small></label>
        <label class="settings-field settings-wide"><span>Code for the page head</span><textarea name="headPlugins" rows="8" maxlength="8000" spellcheck="false" autocapitalize="off" placeholder="For example: &lt;meta name=&quot;site-verification&quot; content=&quot;...&quot;&gt;"></textarea><small>Add valid HTML or a provider's script tag. Plain text (for example, “xxxxxxxxxxxx”) has no visible effect. Saved code loads in the head on every page.</small></label>
        <label class="settings-field settings-wide"><span>Code before the closing body tag</span><textarea name="bodyPlugins" rows="8" maxlength="8000" spellcheck="false" autocapitalize="off" placeholder="For example: &lt;script src=&quot;https://provider.example/widget.js&quot;&gt;&lt;/script&gt;"></textarea><small>Add valid script or widget markup. Plain text has no visible effect. Saved code loads before the closing body tag on every page.</small></label>
      </div>
    </section>
    <section class="settings-panel settings-tab-panel settings-plans-panel" id="settings-panel-subscription" role="tabpanel" aria-labelledby="settings-tab-subscription" tabindex="0" hidden>
      <div class="settings-plans-intro"><div><p class="settings-eyebrow">SUBSCRIPTION OPTIONS</p><h2>Choose the right workspace</h2><p>Compare plans for your training program. Plan changes are arranged with our team.</p></div><aside class="plan-trial-banner" data-trial-banner hidden><span class="plan-trial-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 7v5l3 2m5-2a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><strong>Free trial</strong><small class="trial-status" data-trial-remaining aria-live="polite"></small></span></aside></div>
      <div class="plan-grid">
        <article class="plan-card" data-plan-card="basic"><p class="settings-eyebrow">CORE WORKSPACE</p><h3>Essential</h3><p class="plan-description">For a department starting to coordinate placements.</p><p class="plan-price"><strong data-plan-price="basic">150 JOD</strong><span>per month</span></p><ul><li>Student and company records</li><li>Opportunity and application tracking</li><li>Placement and task monitoring</li><li>Excel data exports</li></ul><div class="plan-capacity"><strong>Included capacity</strong><span>Students <b>100</b></span><span>Companies <b>10</b></span></div><div class="plan-card-actions"><a class="settings-whatsapp" data-plan-request="basic" href="https://wa.me/213540154968" target="_blank" rel="noopener noreferrer">Choose this plan</a></div></article>
        <article class="plan-card plan-featured" data-plan-card="advanced"><p class="settings-eyebrow">EXPANDED WORKSPACE</p><h3>Advanced</h3><p class="plan-description">For a larger training program that needs deeper oversight.</p><p class="plan-price"><strong data-plan-price="advanced">350 JOD</strong><span>per month</span></p><ul><li>Everything in Essential</li><li>Expanded coordinator reporting</li><li>Priority support and onboarding</li><li>Higher agreed capacity for records</li></ul><div class="plan-capacity"><strong>Included capacity</strong><span>Students <b>500</b></span><span>Companies <b>50</b></span></div><div class="plan-card-actions"><a class="settings-whatsapp" data-plan-request="advanced" href="https://wa.me/213540154968" target="_blank" rel="noopener noreferrer">Choose this plan</a></div></article>
        <article class="plan-card plan-custom" data-plan-card="custom"><p class="settings-eyebrow">TAILORED WORKSPACE</p><h3>Custom</h3><p class="plan-description">For institutions that need a configuration tailored to their program.</p><p class="plan-price"><strong>Custom quote</strong><span>based on your needs</span></p><ul><li>Capacity tailored to your institution</li><li>Features and reporting agreed together</li><li>Dedicated setup and onboarding</li><li>Priority support options</li></ul><div class="plan-capacity"><strong>Designed around your program</strong><span>Students <b>Agreed capacity</b></span><span>Companies <b>Agreed capacity</b></span></div><div class="plan-card-actions"><a class="settings-whatsapp" data-plan-request="custom" href="https://wa.me/213540154968" target="_blank" rel="noopener noreferrer">Contact us about Custom</a></div></article>
      </div>
      <input type="hidden" name="currentPlan" value="basic" />
    </section>
    <div class="settings-actions"><span class="settings-dirty" data-settings-dirty hidden>Unsaved changes · preview active</span><button class="settings-save" type="button" data-save-settings>Save site settings</button><button class="settings-reset" type="button" data-reset-settings>Discard unsaved changes</button></div>
  </div>
</main>
</asp:Content>

