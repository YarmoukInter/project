<%@ Page Title="AboutUs" Language="C#" MasterPageFile="~/PublicPages/Section.Master" AutoEventWireup="true" CodeBehind="AboutUs.aspx.cs" Inherits="Yarmouk.PublicPages.AboutUs" %>
<asp:Content ID="HeadSection" ContentPlaceHolderID="HeadContent" runat="server">
<link href="<%= ResolveUrl("~/Content/PublicPages/AboutUs.css") %>" rel="stylesheet" />
<script src="<%= ResolveUrl("~/Scripts/PublicPages/AboutUs.js") %>" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Inter:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" />
</asp:Content>
<asp:Content ID="BodySection" ContentPlaceHolderID="MainContent" runat="server">

    <div class="about-page" id="aboutPage" lang="ar" dir="rtl">
        <section class="about-hero" aria-labelledby="aboutTitle">
            <div class="about-hero-pattern" aria-hidden="true"><span class="about-hero-orbit about-hero-orbit-one"></span><span class="about-hero-orbit about-hero-orbit-two"></span><span class="about-hero-spark about-hero-spark-one"></span><span class="about-hero-spark about-hero-spark-two"></span></div>
            <div class="about-hero-copy">
                <div class="about-kicker"><span class="about-kicker-mark"><i class="fa-solid fa-landmark" aria-hidden="true"></i></span><span data-about-i18n="kicker">جامعة اليرموك · كلية تكنولوجيا المعلومات وعلوم الحاسوب</span></div>
                <h1 id="aboutTitle" data-about-i18n="heroTitle">منظومة واحدة، وتجربة تدريب أكثر وضوحًا</h1>
                <p class="about-hero-lead" data-about-i18n="heroText">منظومة التدريب الميداني والتقييم الأكاديمي (UIMS) تنظّم رحلة التدريب، وتجمع الطالب وجهة التدريب والمشرف الأكاديمي ومنسق الكلية في مساحة رقمية موحدة.</p>
                <div class="about-hero-actions"><button type="button" class="about-button about-button-light about-language-toggle" id="aboutLanguageToggle" aria-label="Switch to English"><i class="fa-solid fa-globe" aria-hidden="true"></i><span data-about-i18n="languageLabel">English</span></button><a class="about-button about-button-gold about-magnetic" href='<%= ResolveUrl("~/PublicPages/Login.aspx") %>'><span data-about-i18n="loginCta">الدخول إلى المنظومة</span><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a><a class="about-button about-button-light about-magnetic" href='<%= ResolveUrl("~/PublicPages/ContactUs.aspx") %>'><i class="fa-regular fa-message" aria-hidden="true"></i><span data-about-i18n="contactCta">تواصل معنا</span></a></div>
            </div>
            <div class="about-hero-emblem" aria-label="جامعة اليرموك"><span class="about-emblem-halo" aria-hidden="true"></span><span class="about-emblem-orbit-dot" aria-hidden="true"></span><div class="about-logo-frame"><img src='<%= ResolveUrl("~/Content/Images/yarmouk-college-logo.png") %>' alt="" /></div><span data-about-i18n="university">جامعة اليرموك</span><small data-about-i18n="college">كلية تكنولوجيا المعلومات وعلوم الحاسوب</small><div class="about-emblem-rule"></div><strong>UIMS</strong><small data-about-i18n="systemLabel">منظومة التدريب الميداني</small><div class="about-emblem-signals" aria-hidden="true"><i class="fa-solid fa-graduation-cap"></i><i class="fa-solid fa-building-columns"></i><i class="fa-solid fa-chart-line"></i></div></div>
        </section>

        <section class="about-facts" aria-label="حقائق عن التدريب" data-about-aria="facts">
            <article class="about-fact about-reveal"><span class="about-fact-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></span><div><strong class="about-counter" data-count="8">8</strong><span data-about-i18n="hoursFact">أسابيع تدريب ميداني</span></div></article>
            <article class="about-fact about-reveal"><span class="about-fact-icon about-fact-gold"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span><div><strong class="about-counter" data-count="3">3</strong><span data-about-i18n="creditsFact">ساعات معتمدة</span></div></article>
            <article class="about-fact about-reveal"><span class="about-fact-icon about-fact-blue"><i class="fa-solid fa-people-group" aria-hidden="true"></i></span><div><strong class="about-counter" data-count="4">4</strong><span data-about-i18n="rolesFact">أطراف تعمل معًا</span></div></article>
        </section>

        <section class="about-story about-bento-grid about-reveal" aria-labelledby="storyTitle">
            <div class="about-story-copy"><span class="about-section-kicker" data-about-i18n="storyKicker">عن المنظومة</span><h2 id="storyTitle" data-about-i18n="storyTitle">من المعرفة الأكاديمية إلى خبرة عملية</h2><p data-about-i18n="storyP1">تمنح تجربة التدريب الميداني الطلبة فرصة لتطبيق ما تعلموه في بيئة عمل حقيقية، والتعرف إلى متطلبات المهنة قبل التخرج.</p><p data-about-i18n="storyP2">تدعم UIMS هذه التجربة بتنظيم بيانات التدريب ومتابعة المهام والساعات والتقييمات، وتسهيل التواصل بين جميع الأطراف طوال فترة التدريب.</p><div class="about-principle"><i class="fa-solid fa-compass" aria-hidden="true"></i><span data-about-i18n="principle">مسار واضح للطالب، ومتابعة منسقة للجامعة وجهة التدريب.</span></div></div>
            <aside class="about-purpose" data-tilt aria-labelledby="purposeTitle"><div class="about-purpose-icon"><i class="fa-solid fa-bullseye" aria-hidden="true"></i></div><span class="about-section-kicker" data-about-i18n="purposeKicker">هدفنا</span><h2 id="purposeTitle" data-about-i18n="purposeTitle">تجربة تدريب أكثر تنظيمًا وشفافية</h2><p data-about-i18n="purposeText">تمكين الأطراف من متابعة الالتزامات والإنجازات والتقييمات ضمن خطوات مفهومة ومعلومات محدثة.</p><ul><li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-about-i18n="purposeOne">توحيد رحلة التدريب ومعلوماتها</span></li><li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-about-i18n="purposeTwo">توضيح الأدوار ومتطلبات كل مرحلة</span></li><li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-about-i18n="purposeThree">دعم التوجيه والتغذية الراجعة</span></li></ul></aside>
        </section>

        <section class="about-roles" aria-labelledby="rolesTitle"><div class="about-section-heading about-reveal"><div><span class="about-section-kicker" data-about-i18n="rolesKicker">أطراف الرحلة</span><h2 id="rolesTitle" data-about-i18n="rolesTitle">كل دور يعرف خطوته التالية</h2></div><p data-about-i18n="rolesIntro">تربط المنظومة أربعة أدوار رئيسية ضمن تجربة تدريب واحدة.</p></div>
            <div class="about-role-grid about-timeline">
                <article class="about-role-card about-reveal" data-tilt><span class="about-role-number">01</span><span class="about-role-icon role-green"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i></span><h3 data-about-i18n="studentTitle">الطالب المتدرب</h3><p data-about-i18n="studentText">يستكشف الفرص، ويتابع المهام والساعات، ويطّلع على التوجيه والتقييمات خلال التدريب.</p></article>
                <article class="about-role-card about-reveal" data-tilt><span class="about-role-number">02</span><span class="about-role-icon role-gold"><i class="fa-solid fa-building" aria-hidden="true"></i></span><h3 data-about-i18n="companyTitle">مشرف جهة التدريب</h3><p data-about-i18n="companyText">يستقبل المتدرب، ويتابع حضوره ومهامه، ويقدم التقييم الميداني.</p></article>
                <article class="about-role-card about-reveal" data-tilt><span class="about-role-number">03</span><span class="about-role-icon role-blue"><i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i></span><h3 data-about-i18n="academicTitle">المشرف الأكاديمي</h3><p data-about-i18n="academicText">يرشد الطالب أكاديميًا، ويتابع تقدمه وتقاريره، ويرصد التقييم الأكاديمي.</p></article>
                <article class="about-role-card about-reveal" data-tilt><span class="about-role-number">04</span><span class="about-role-icon role-purple"><i class="fa-solid fa-sitemap" aria-hidden="true"></i></span><h3 data-about-i18n="coordinatorTitle">منسق التدريب</h3><p data-about-i18n="coordinatorText">ينظم بيانات التدريب والتوزيع والمتابعة، ويراجع إجراءات الإكمال.</p></article>
            </div>
        </section>

        <section class="about-evaluation about-reveal" aria-labelledby="evaluationTitle"><div class="about-evaluation-heading"><span class="about-evaluation-icon"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i></span><div><span class="about-section-kicker" data-about-i18n="evaluationKicker">آلية التقييم</span><h2 id="evaluationTitle" data-about-i18n="evaluationTitle">مكونات التقييم</h2><p data-about-i18n="evaluationText">تتبع آلية التقييم النماذج المعتمدة من القسم، وتشمل تقارير المشرف والجهة وتقرير الطالب والعرض.</p></div></div><div class="about-weight-list"><div class="about-weight"><div class="about-weight-head"><span data-about-i18n="companyWeight">تقرير مشرف التدريب</span></div></div><div class="about-weight"><div class="about-weight-head"><span data-about-i18n="academicWeight">تقرير جهة التدريب</span></div></div><div class="about-weight"><div class="about-weight-head"><span data-about-i18n="reportWeight">التقرير التفصيلي والعرض</span></div></div></div></section>

        <section class="about-bottom-cta about-reveal"><div><span class="about-section-kicker" data-about-i18n="ctaKicker">هل تحتاج إلى مساعدة؟</span><h2 data-about-i18n="ctaTitle">نحن هنا للإجابة عن استفساراتك</h2></div><a class="about-button about-button-green about-magnetic" href='<%= ResolveUrl("~/PublicPages/ContactUs.aspx") %>'><span data-about-i18n="ctaButton">انتقل إلى صفحة التواصل</span><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a></section>
    </div>
</asp:Content>
