<%@ Page Title="Final Academic Evaluation" Language="C#" MasterPageFile="~/AcademicPages/Section.Master" Async="true" AutoEventWireup="true" CodeBehind="FinalEvaluation.aspx.cs" Inherits="Yarmouk.AcademicPages.FinalEvaluation" %>
<asp:Content ID="HeadSection" ContentPlaceHolderID="HeadContent" runat="server">
<link href="<%= ResolveUrl("~/Content/AcademicPages/FinalEvaluation.css?v=company-pdf-1") %>" rel="stylesheet" />
<script src="<%= ResolveUrl("~/Scripts/AcademicPages/FinalEvaluation.js?v=review-drawer-3") %>" defer></script>
<link href="../Content/Shared/workspace-polish.css?v=1" rel="stylesheet" />
<link href="../Content/Shared/record-lists.css?v=organized-2" rel="stylesheet" />
<script src="../Scripts/Shared/record-lists.js?v=review-groups-3" defer></script>
<link href="../Content/Shared/review-workspaces.css?v=review-queue-2" rel="stylesheet" />
</asp:Content>
<asp:Content ID="BodySection" ContentPlaceHolderID="MainContent" runat="server">
<section class="academic-evaluation-workspace">
  <header class="evaluation-heading"><div><span class="evaluation-eyebrow">ACADEMIC SUPERVISOR</span><h1>Final Academic Evaluation</h1><p>Record your final assessment for an assigned placement and follow the company and university approval steps.</p></div><span class="evaluation-cycle"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg> Academic · 60%</span></header>
  <asp:Panel ID="EvaluationMessage" runat="server" CssClass="evaluation-alert" Visible="false" role="status"><asp:Literal ID="EvaluationMessageText" runat="server" /></asp:Panel>
  <p class="evaluation-workflow-guide"><strong>Review flow</strong><span>Company assessment <b>40%</b></span><span aria-hidden="true">→</span><span>Academic assessment <b>60%</b></span><span aria-hidden="true">→</span><span>University approval</span></p>
  <div class="evaluation-list-heading"><div><h2>Evaluation queue</h2><p>Start with placements ready for academic review.</p></div><span class="evaluation-count"><asp:Literal ID="EvaluationQueueCount" runat="server" /> placements</span></div>
  <div class="evaluation-state-filters" role="group" aria-label="Evaluation review status"><button type="button" data-evaluation-filter="all" data-filter="all" aria-pressed="true">All evaluations <span data-evaluation-count="all">0</span></button><button type="button" data-evaluation-filter="ready" data-filter="ready" aria-pressed="false">Ready for review <span data-evaluation-count="ready">0</span></button><button type="button" data-evaluation-filter="waiting" data-filter="waiting" aria-pressed="false">Waiting for company <span data-evaluation-count="waiting">0</span></button><button type="button" data-evaluation-filter="submitted" data-filter="submitted" aria-pressed="false">Submitted <span data-evaluation-count="submitted">0</span></button></div>
  <asp:Panel ID="EvaluationEmpty" runat="server" CssClass="evaluation-empty" Visible="false"><span class="evaluation-empty-icon" aria-hidden="true">✳</span><h3>No evaluations in your queue</h3><p>Academic evaluations appear here for placements assigned to your account.</p></asp:Panel>
  <asp:Repeater ID="EvaluationQueue" runat="server" OnItemCommand="EvaluationQueue_ItemCommand">
    <HeaderTemplate><div class="evaluation-queue-region" role="region" aria-label="Placement evaluation queue" tabindex="0"><table class="evaluation-queue-table"><caption class="visually-hidden">Placement evaluations, company assessments, academic review and university approval</caption><thead><tr><th scope="col">Student</th><th scope="col">Training provider</th><th scope="col">Company assessment</th><th scope="col">Academic review</th><th scope="col">University approval</th><th scope="col"><span class="visually-hidden">Review action</span></th></tr></thead><tbody class="evaluation-cards"></HeaderTemplate>
    <ItemTemplate>
      <tr class="evaluation-card" data-status='<%# Convert.ToBoolean(Eval("AcademicSubmitted")) ? "submitted" : (Convert.ToBoolean(Eval("CanSubmit")) ? "ready" : "waiting") %>' data-company='<%#: Eval("CompanyName") %>'>
        <td data-label="Student"><span class="evaluation-student-identity"><span class="student-avatar uims-student-photo-avatar" data-student-photo-url='<%#: Eval("ProfileImageUrl") %>'><span><%#: Eval("Initials") %></span></span><span><strong class="evaluation-student-name"><%#: Eval("StudentName") %></strong><span class="evaluation-student-number">ID <%#: Eval("StudentNumber") %></span></span></span></td>
        <td data-label="Training provider"><strong class="evaluation-provider"><%#: Eval("CompanyName") %></strong><span class="evaluation-cell-note"><%#: Eval("PlacementStatus") %></span></td>
        <td data-label="Company assessment"><strong class="evaluation-cell-value"><%#: Eval("CompanyStatusLabel") %></strong><span class="evaluation-cell-note"><%#: Eval("CompanyScoreLabel") %></span><asp:HyperLink runat="server" CssClass="evaluation-download-link" Visible='<%# Convert.ToBoolean(Eval("CompanySubmitted")) %>' NavigateUrl='<%# "~/AcademicPages/CompanyEvaluationPdf.ashx?placementId=" + System.Web.HttpUtility.UrlEncode(Convert.ToString(Eval("PlacementId"))) %>' Text="Company PDF" /></td>
        <td data-label="Academic review"><span class='evaluation-status <%# Convert.ToBoolean(Eval("AcademicSubmitted")) ? "is-submitted" : "" %>'><%#: Eval("EvaluationStatusLabel") %></span></td>
        <td data-label="University approval"><strong class="evaluation-cell-value"><%#: Eval("ApprovalStatusLabel") %></strong><span class="evaluation-cell-note"><%#: Eval("ProposedFinalScoreLabel") %></span></td>
        <td class="evaluation-action-cell"><button type="button" class="evaluation-open-button" data-open-evaluation><%# Convert.ToBoolean(Eval("CanSave")) ? (Convert.ToBoolean(Eval("CanSubmit")) ? "Review" : "Prepare draft") : "View result" %><span aria-hidden="true">→</span></button>
        <div class="evaluation-dialog" hidden role="dialog" aria-modal="true" aria-label='Evaluation for <%#: Eval("StudentName") %>' data-placement-id='<%#: Eval("PlacementId") %>' tabindex="-1">
          <div class="evaluation-dialog-panel">
          <div class="evaluation-dialog-header"><div><span class="evaluation-eyebrow">ACADEMIC REVIEW · 60%</span><h3>Evaluation for <%#: Eval("StudentName") %></h3><p><%#: Eval("CompanyName") %> · Student ID <%#: Eval("StudentNumber") %></p></div><button type="button" class="evaluation-dialog-close" data-close-evaluation aria-label="Close evaluation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
          <div class="evaluation-dialog-status"><span>Company assessment</span><strong><%#: Eval("CompanyStatusLabel") %> · <%#: Eval("CompanyScoreLabel") %></strong></div>
          <p class="evaluation-pending-hint" runat="server" visible='<%# Convert.ToBoolean(Eval("CanSave")) && !Convert.ToBoolean(Eval("CanSubmit")) %>'>You can save your academic and Zoom meeting review as a draft now. Submit result becomes available after the company sends its evaluation.</p>
          <div class="evaluation-form-grid"><div class="evaluation-field evaluation-field--score"><div class="evaluation-field-label"><asp:Label ID="AcademicScoreLabel" runat="server" AssociatedControlID="AcademicScoreInput" Text="Academic score" /><span>0–100</span></div><div class="score-input-wrap"><asp:TextBox ID="AcademicScoreInput" runat="server" TextMode="Number" min="0" max="100" step="1" Text='<%# Eval("AcademicScoreInput") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' aria-required="true" /><span>/ 100</span></div><small>Weighted at 60% when combined with the company evaluation.</small></div><div class="evaluation-field"><asp:Label ID="AcademicFeedbackLabel" runat="server" CssClass="evaluation-field-label" AssociatedControlID="AcademicFeedbackInput" Text="Academic feedback" /><asp:TextBox ID="AcademicFeedbackInput" runat="server" TextMode="MultiLine" Rows="4" MaxLength="2000" placeholder="Summarize achievements, professional conduct, and recommendations..." Text='<%# Eval("AcademicFeedback") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' data-evaluation-feedback="true" /><div class="feedback-field-hint"><small>Visible to the university review workflow.</small><span data-char-count aria-live="polite">0 / 2000</span></div></div></div>
          <section class="zoom-review"><h4>Academic review meeting</h4><p>Share the date, secure Zoom link, and an optional note. The student sees these details after completing every assigned task.</p><div class="zoom-review-grid"><div class="evaluation-field"><asp:Label ID="ZoomMeetingDateLabel" runat="server" AssociatedControlID="ZoomMeetingDateInput" Text="Meeting date" /><asp:TextBox ID="ZoomMeetingDateInput" runat="server" TextMode="Date" Text='<%# Eval("ZoomMeetingDate") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' /></div><div class="evaluation-field"><asp:Label ID="ZoomMeetingUrlLabel" runat="server" AssociatedControlID="ZoomMeetingUrlInput" Text="Zoom link (optional)" /><asp:TextBox ID="ZoomMeetingUrlInput" runat="server" TextMode="Url" Text='<%# Eval("ZoomMeetingUrl") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' placeholder="https://..." /></div></div><div class="evaluation-field"><asp:Label ID="ZoomMeetingAssessmentLabel" runat="server" AssociatedControlID="ZoomMeetingAssessmentInput" Text="Note for the student (optional)" /><asp:TextBox ID="ZoomMeetingAssessmentInput" runat="server" TextMode="MultiLine" Rows="3" MaxLength="2000" Text='<%# Eval("ZoomMeetingAssessment") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' placeholder="Add preparation instructions or a note for the student." /></div></section>
          <footer class="evaluation-dialog-actions"><asp:Button ID="SaveDraftButton" runat="server" Text="Save draft" CssClass="evaluation-button evaluation-button--secondary" CommandName="draft" CommandArgument='<%# Eval("PlacementId") %>' CausesValidation="false" formnovalidate="formnovalidate" Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' /><asp:Button ID="SubmitEvaluationButton" runat="server" Text="Submit result" CssClass="evaluation-button evaluation-button--primary" CommandName="submit" CommandArgument='<%# Eval("PlacementId") %>' CausesValidation="false" formnovalidate="formnovalidate" Enabled='<%# Convert.ToBoolean(Eval("CanSubmit")) %>' /></footer>
          </div>
        </div>
        </td>
      </tr>
    </ItemTemplate>
    <FooterTemplate></tbody></table></div></FooterTemplate>
  </asp:Repeater>
</section>
</asp:Content>
