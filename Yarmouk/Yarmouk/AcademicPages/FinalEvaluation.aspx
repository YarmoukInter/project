<%@ Page Title="Final Academic Evaluation" Language="C#" MasterPageFile="~/AcademicPages/Section.Master" Async="true" AutoEventWireup="true" CodeBehind="FinalEvaluation.aspx.cs" Inherits="Yarmouk.AcademicPages.FinalEvaluation" %>
<asp:Content ID="HeadSection" ContentPlaceHolderID="HeadContent" runat="server">
<link href="<%= ResolveUrl("~/Content/AcademicPages/FinalEvaluation.css?v=zoom-review-1") %>" rel="stylesheet" />
<script src="<%= ResolveUrl("~/Scripts/AcademicPages/FinalEvaluation.js?v=zoom-review-1") %>" defer></script>
</asp:Content>
<asp:Content ID="BodySection" ContentPlaceHolderID="MainContent" runat="server">
<section class="academic-evaluation-workspace">
  <header class="evaluation-heading"><div><span class="evaluation-eyebrow">ACADEMIC SUPERVISOR</span><h1>Final Academic Evaluation</h1><p>Record your final assessment for an assigned placement and follow the company and university approval steps.</p></div><span class="evaluation-cycle"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg> Academic · 60%</span></header>
  <asp:Panel ID="EvaluationMessage" runat="server" CssClass="evaluation-alert" Visible="false" role="status"><asp:Literal ID="EvaluationMessageText" runat="server" /></asp:Panel>
  <div class="evaluation-process" aria-label="Evaluation workflow"><span class="process-step process-step--academic"><b>1</b><span>Academic evaluation</span></span><i></i><span class="process-step"><b>2</b><span>Company evaluation</span></span><i></i><span class="process-step"><b>3</b><span>University approval</span></span></div>
  <div class="evaluation-list-heading"><div><span class="evaluation-eyebrow">ASSIGNED PLACEMENTS</span><h2>Students awaiting your review</h2></div><span class="evaluation-count"><asp:Literal ID="EvaluationQueueCount" runat="server" /> placements</span></div>
  <asp:Panel ID="EvaluationEmpty" runat="server" CssClass="evaluation-empty" Visible="false"><span class="evaluation-empty-icon" aria-hidden="true">✳</span><h3>No evaluations in your queue</h3><p>Academic evaluations appear here for placements assigned to your account.</p></asp:Panel>
  <asp:Repeater ID="EvaluationQueue" runat="server" OnItemCommand="EvaluationQueue_ItemCommand">
    <HeaderTemplate><div class="evaluation-cards"></HeaderTemplate>
    <ItemTemplate>
      <article class="evaluation-card">
        <header class="evaluation-card-header"><div class="evaluation-person"><span class="evaluation-avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.3"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg></span><div class="evaluation-person-copy"><span class="evaluation-student-id">STUDENT <%#: Eval("StudentNumber") %></span><h3><%#: Eval("StudentName") %></h3><p><%#: Eval("CompanyName") %> <span aria-hidden="true">·</span> <%#: Eval("PlacementStatus") %></p></div></div><span class='evaluation-status <%# Convert.ToBoolean(Eval("AcademicSubmitted")) ? "is-submitted" : "" %>'><%#: Eval("EvaluationStatusLabel") %></span></header>
        <div class="evaluation-workflow-grid"><div><span class="workflow-label">Company assessment</span><strong><%#: Eval("CompanyStatusLabel") %></strong><small><%#: Eval("CompanyScoreLabel") %></small></div><div><span class="workflow-label">University review</span><strong><%#: Eval("ApprovalStatusLabel") %></strong><small><%#: Eval("ProposedFinalScoreLabel") %></small></div></div>
        <footer class="evaluation-card-actions"><span class="evaluation-lock-note"><span class="evaluation-action-label"><%# Convert.ToBoolean(Eval("CanSave")) ? "Your review" : "Submitted review" %></span><span><%# Convert.ToBoolean(Eval("CanSave")) ? "Add your score and feedback for this placement." : "This evaluation is locked after submission." %></span></span><button type="button" class="evaluation-open-button" data-open-evaluation><%# Convert.ToBoolean(Eval("CanSave")) ? (Convert.ToBoolean(Eval("CanSubmit")) ? "Enter evaluation" : "Prepare draft") : "View evaluation" %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></button></footer>
        <div class="evaluation-dialog" hidden role="dialog" aria-modal="true" aria-label='Evaluation for <%#: Eval("StudentName") %>' data-placement-id='<%#: Eval("PlacementId") %>' tabindex="-1">
          <div class="evaluation-dialog-panel">
          <div class="evaluation-dialog-header"><div><span class="evaluation-eyebrow">ACADEMIC REVIEW · 60%</span><h3>Evaluation for <%#: Eval("StudentName") %></h3><p><%#: Eval("CompanyName") %> · Student ID <%#: Eval("StudentNumber") %></p></div><button type="button" class="evaluation-dialog-close" data-close-evaluation aria-label="Close evaluation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
          <div class="evaluation-dialog-status"><span>Company assessment</span><strong><%#: Eval("CompanyStatusLabel") %> · <%#: Eval("CompanyScoreLabel") %></strong></div>
          <p class="evaluation-pending-hint" runat="server" visible='<%# Convert.ToBoolean(Eval("CanSave")) && !Convert.ToBoolean(Eval("CanSubmit")) %>'>You can save your academic and Zoom meeting review as a draft now. Submit result becomes available after the company sends its evaluation.</p>
          <div class="evaluation-form-grid"><div class="evaluation-field evaluation-field--score"><div class="evaluation-field-label"><asp:Label ID="AcademicScoreLabel" runat="server" AssociatedControlID="AcademicScoreInput" Text="Academic score" /><span>0–100</span></div><div class="score-input-wrap"><asp:TextBox ID="AcademicScoreInput" runat="server" TextMode="Number" min="0" max="100" step="1" Text='<%# Eval("AcademicScoreInput") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' required="required" /><span>/ 100</span></div><small>Weighted at 60% when combined with the company evaluation.</small></div><div class="evaluation-field"><asp:Label ID="AcademicFeedbackLabel" runat="server" CssClass="evaluation-field-label" AssociatedControlID="AcademicFeedbackInput" Text="Academic feedback" /><asp:TextBox ID="AcademicFeedbackInput" runat="server" TextMode="MultiLine" Rows="4" MaxLength="2000" placeholder="Summarize achievements, professional conduct, and recommendations..." Text='<%# Eval("AcademicFeedback") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' data-evaluation-feedback="true" /><div class="feedback-field-hint"><small>Visible to the university review workflow.</small><span data-char-count aria-live="polite">0 / 2000</span></div></div></div>
          <section class="zoom-review"><h4>Zoom meeting evaluation</h4><p>Record your discussion with the student. Include its outcome in the academic score above.</p><div class="zoom-review-grid"><div class="evaluation-field"><asp:Label ID="ZoomMeetingDateLabel" runat="server" AssociatedControlID="ZoomMeetingDateInput" Text="Meeting date" /><asp:TextBox ID="ZoomMeetingDateInput" runat="server" TextMode="Date" Text='<%# Eval("ZoomMeetingDate") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' /></div><div class="evaluation-field"><asp:Label ID="ZoomMeetingUrlLabel" runat="server" AssociatedControlID="ZoomMeetingUrlInput" Text="Zoom link (optional)" /><asp:TextBox ID="ZoomMeetingUrlInput" runat="server" TextMode="Url" Text='<%# Eval("ZoomMeetingUrl") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' placeholder="https://..." /></div></div><div class="evaluation-field"><asp:Label ID="ZoomMeetingAssessmentLabel" runat="server" AssociatedControlID="ZoomMeetingAssessmentInput" Text="Meeting assessment" /><asp:TextBox ID="ZoomMeetingAssessmentInput" runat="server" TextMode="MultiLine" Rows="3" MaxLength="2000" Text='<%# Eval("ZoomMeetingAssessment") %>' Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' placeholder="Summarize the student's presentation, answers, and areas to improve." /></div></section>
          <footer class="evaluation-dialog-actions"><asp:Button ID="SaveDraftButton" runat="server" Text="Save draft" CssClass="evaluation-button evaluation-button--secondary" CommandName="draft" CommandArgument='<%# Eval("PlacementId") %>' CausesValidation="false" Enabled='<%# Convert.ToBoolean(Eval("CanSave")) %>' /><asp:Button ID="SubmitEvaluationButton" runat="server" Text="Submit result" CssClass="evaluation-button evaluation-button--primary" CommandName="submit" CommandArgument='<%# Eval("PlacementId") %>' CausesValidation="false" Enabled='<%# Convert.ToBoolean(Eval("CanSubmit")) %>' /></footer>
          </div>
        </div>
      </article>
    </ItemTemplate>
    <FooterTemplate></div></FooterTemplate>
  </asp:Repeater>
</section>
</asp:Content>
