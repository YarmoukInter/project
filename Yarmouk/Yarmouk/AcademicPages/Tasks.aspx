<%@ Page Title="Student Tasks" Language="C#" MasterPageFile="~/AcademicPages/Section.Master" Async="true" AutoEventWireup="true" CodeBehind="Tasks.aspx.cs" Inherits="Yarmouk.AcademicPages.Tasks" %>
<asp:Content ID="HeadSection" ContentPlaceHolderID="HeadContent" runat="server"><link href="<%= ResolveUrl("~/Content/AcademicPages/Tasks.css") %>" rel="stylesheet" /><script src="<%= ResolveUrl("~/Scripts/AcademicPages/Tasks.js") %>" defer></script></asp:Content>
<asp:Content ID="BodySection" ContentPlaceHolderID="MainContent" runat="server">
<section class="academic-tasks"><header><span class="eyebrow">ACADEMIC SUPERVISOR</span><h1>Student tasks</h1><p>Follow tasks for students assigned to you, including submissions and deadlines.</p></header>
<asp:Panel ID="TasksError" runat="server" Visible="false" CssClass="tasks-message" role="alert"><asp:Literal ID="TasksErrorText" runat="server" /></asp:Panel>
<div class="tasks-tools"><label>Search <input id="academicTaskSearch" type="search" placeholder="Student or task title" /></label><label>Status <select id="academicTaskStatus"><option value="all">All statuses</option><option value="todo">To do</option><option value="inprogress">In progress</option><option value="done">Submitted</option><option value="completed">Completed</option></select></label><span><asp:Literal ID="TasksCount" runat="server" /> tasks</span></div>
<asp:Repeater ID="TaskList" runat="server"><HeaderTemplate><div class="academic-task-grid"></HeaderTemplate><ItemTemplate><article class="academic-task-card" data-status='<%#: Eval("StatusKey") %>'><div class="task-top"><span class="task-student"><%#: Eval("StudentName") %></span><span class="task-status"><%#: Eval("StatusLabel") %></span></div><h2><%#: Eval("Title") %></h2><p><%#: Eval("Description") %></p><div class="task-bottom"><span>Due: <%#: Eval("DueLabel") %></span><asp:HyperLink runat="server" NavigateUrl='<%# Eval("TaskUrl") %>' Target="_blank" Visible='<%# !String.IsNullOrWhiteSpace(Convert.ToString(Eval("TaskUrl"))) %>'>Task file ↗</asp:HyperLink></div></article></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater>
<asp:Panel ID="TasksEmpty" runat="server" Visible="false" CssClass="tasks-message">No tasks are assigned to your students yet.</asp:Panel><p id="academicTaskNoMatch" class="tasks-message" hidden>No tasks match these filters.</p></section>
</asp:Content>
