<%@ Page Title="Student Tasks" Language="C#" MasterPageFile="~/AcademicPages/Section.Master" Async="true" AutoEventWireup="true" CodeBehind="Tasks.aspx.cs" Inherits="Yarmouk.AcademicPages.Tasks" %>
<asp:Content ID="HeadSection" ContentPlaceHolderID="HeadContent" runat="server"><link href="<%= ResolveUrl("~/Content/AcademicPages/Tasks.css") %>" rel="stylesheet" /><link href="../Content/Shared/workspace-polish.css?v=1" rel="stylesheet" />
<link href="../Content/Shared/record-lists.css?v=organized-2" rel="stylesheet" />
<script src="../Scripts/Shared/record-lists.js?v=organized-2" defer></script>
</asp:Content>
<asp:Content ID="BodySection" ContentPlaceHolderID="MainContent" runat="server">
<section class="academic-tasks"><header><span class="eyebrow">ACADEMIC SUPERVISOR</span><h1>Student tasks</h1><p>Follow tasks for students assigned to you, including submissions and deadlines.</p></header>
<asp:Panel ID="TasksError" runat="server" Visible="false" CssClass="tasks-message" role="alert"><asp:Literal ID="TasksErrorText" runat="server" /></asp:Panel>
<div class="task-register-heading"><div><h2>Assigned tasks</h2><p>Review submissions first, or narrow the list to a student.</p></div><span class="task-register-total"><asp:Literal ID="TasksCount" runat="server" /> tasks</span></div>
<asp:Repeater ID="TaskList" runat="server"><HeaderTemplate><div class="task-register-region" role="region" aria-label="Student task register" tabindex="0"><table class="task-register"><caption class="visually-hidden">Assigned student tasks, due dates, and review status</caption><thead><tr><th scope="col">Student</th><th scope="col">Task</th><th scope="col">Due date</th><th scope="col">Status</th><th scope="col">Resource</th></tr></thead><tbody id="academic-task-rows"></HeaderTemplate><ItemTemplate><tr data-status='<%#: Eval("StatusKey") %>' data-student='<%#: Eval("StudentName") %>'><td data-label="Student"><strong class="task-student"><%#: Eval("StudentName") %></strong></td><td data-label="Task"><h3 class="task-register-title"><%#: Eval("Title") %></h3><details class="task-description"><summary>View description</summary><p><%#: Eval("Description") %></p></details></td><td data-label="Due date"><span class="task-due"><%#: Eval("DueLabel") %></span></td><td data-label="Status"><span class='task-status task-status--<%#: Eval("StatusKey") %>'><%#: Eval("StatusLabel") %></span></td><td data-label="Resource"><asp:HyperLink runat="server" NavigateUrl='<%# Eval("TaskUrl") %>' Target="_blank" rel="noopener noreferrer" CssClass="task-resource-link" Visible='<%# !String.IsNullOrWhiteSpace(Convert.ToString(Eval("TaskUrl"))) %>'>Open task file <span aria-hidden="true">↗</span></asp:HyperLink></td></tr></ItemTemplate><FooterTemplate></tbody></table></div></FooterTemplate></asp:Repeater>
<asp:Panel ID="TasksEmpty" runat="server" Visible="false" CssClass="tasks-message">No tasks are assigned to your students yet.</asp:Panel></section>
</asp:Content>
