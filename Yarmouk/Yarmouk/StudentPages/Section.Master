<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Section.Master.cs" Inherits="Yarmouk.StudentPages.SectionMaster" %>
<!DOCTYPE html>
<html lang="en" class="student-app">
<head runat="server">
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%: Page.Title %> — Student Workspace</title>
<link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>" rel="stylesheet" />
<link href="<%= ResolveUrl("~/Content/StudentPages/shared.css") %>" rel="stylesheet" />
<link href="<%= ResolveUrl("~/Content/StudentPages/student-shell.css") %>?v=admin-style-1" rel="stylesheet" />
<asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="student-app">
<form id="form1" runat="server" class="student-layout">
<svg class="student-icon-library" aria-hidden="true" focusable="false"><defs>
  <symbol id="student-icon-dashboard" viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/></symbol>
  <symbol id="student-icon-opportunities" viewBox="0 0 24 24"><path d="M3 7h18v14H3zM8 7V3h8v4M3 11l9 3 9-3M10 12h4v4h-4z"/></symbol>
  <symbol id="student-icon-applications" viewBox="0 0 24 24"><path d="M5 3h14v18H5zM8 8h8M8 12h8M8 16h5"/></symbol>
  <symbol id="student-icon-tasks" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 5h1v2H3zM3 11h1v2H3zM3 17h1v2H3z"/></symbol>
  <symbol id="student-icon-progress" viewBox="0 0 24 24"><path d="M3 3v18h18M7 14l5-5 4 3 5-7M16 5h5v5"/></symbol>
  <symbol id="student-icon-profile" viewBox="0 0 24 24"><path d="M16 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0M4 22v-3a8 8 0 0 1 16 0v3"/></symbol>
  <symbol id="student-icon-logout" viewBox="0 0 24 24"><path d="M9 4H3v16h6M13 7l5 5-5 5M8 12h14"/></symbol>
  <symbol id="student-icon-chevron" viewBox="0 0 24 24"><path d="M14 6l-6 6 6 6"/></symbol>
  <symbol id="student-icon-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol>
</defs></svg>
<div class="student-sidebar-rail" data-student-nav>
<aside class="student-sidebar" id="student-navigation" aria-label="Student workspace navigation">
  <div class="student-sidebar-inner">
    <div class="student-sidebar-header">
      <a class="student-brand" href="<%= ResolveUrl("~/StudentPages/Dashboard.aspx") %>" aria-label="Yarmouk student workspace home"><img src="<%= ResolveUrl("~/Content/Images/yarmouk-logo-on-dark.svg") %>" width="160" height="52" alt="Yarmouk University" /><span class="student-brand-compact" aria-hidden="true">YU</span></a>
      <button class="student-sidebar-toggle" type="button" aria-expanded="false" aria-label="Expand navigation"><svg aria-hidden="true"><use href="#student-icon-chevron"></use></svg></button>
    </div>
    <p class="student-nav-label">WORKSPACE</p>
    <nav class="student-navigation" aria-label="Student workspace">
      <a href="<%= ResolveUrl("~/StudentPages/Dashboard.aspx") %>" title="Dashboard"><svg aria-hidden="true"><use href="#student-icon-dashboard"></use></svg><span>Dashboard</span></a>
      <a href="<%= ResolveUrl("~/StudentPages/Opportunities.aspx") %>" title="Opportunities"><svg aria-hidden="true"><use href="#student-icon-opportunities"></use></svg><span>Opportunities</span></a>
      <a href="<%= ResolveUrl("~/StudentPages/MyApplications.aspx") %>" title="Applications"><svg aria-hidden="true"><use href="#student-icon-applications"></use></svg><span>Applications</span></a>
      <a href="<%= ResolveUrl("~/StudentPages/MyTasks.aspx") %>" title="My tasks"><svg aria-hidden="true"><use href="#student-icon-tasks"></use></svg><span>My tasks</span></a>
      <a href="<%= ResolveUrl("~/StudentPages/Progress.aspx") %>" title="Progress"><svg aria-hidden="true"><use href="#student-icon-progress"></use></svg><span>Progress</span></a>
    </nav>
    <div class="student-sidebar-bottom">
      <a class="student-profile-link" href="<%= ResolveUrl("~/StudentPages/Profile.aspx") %>" title="Profile"><svg aria-hidden="true"><use href="#student-icon-profile"></use></svg><span>Profile<small>Student account</small></span></a>
      <asp:LinkButton ID="SignOutButton" runat="server" CssClass="student-signout" OnClick="SignOut_Click" CausesValidation="false" formnovalidate="formnovalidate" ToolTip="Sign out"><svg aria-hidden="true"><use href="#student-icon-logout"></use></svg><span>Sign out</span></asp:LinkButton>
      <button class="student-sidebar-pin" type="button" role="switch" aria-checked="false" aria-label="Keep sidebar open"><span>Keep sidebar open</span><span class="student-pin-track" aria-hidden="true"></span></button>
    </div>
  </div>
</aside>
</div>
<button class="student-nav-backdrop" type="button" aria-label="Close student navigation" hidden></button>
<button class="student-nav-toggle" type="button" aria-expanded="false" aria-controls="student-navigation"><svg aria-hidden="true"><use href="#student-icon-menu"></use></svg><span>Menu</span></button>
<div class="student-content">
<header class="student-topline"><a href="<%= ResolveUrl("~/PublicPages/Home.aspx") %>">Yarmouk University</a><span>Student</span></header>
<main class="student-main"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
<footer class="student-footer">
  <div class="student-footer-inner"><a href="<%= ResolveUrl("~/StudentPages/Dashboard.aspx") %>">Yarmouk University</a><span>Internship Management System · Student Workspace</span><span>© <span data-student-year>2026</span> Faculty of IT and Computer Science</span></div>
</footer>
</div>
</form>
<script src="<%= ResolveUrl("~/Scripts/StudentPages/student-shell.js") %>?v=admin-style-1" defer></script>
</body>
</html>
