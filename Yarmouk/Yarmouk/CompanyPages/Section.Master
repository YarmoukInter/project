<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Section.Master.cs" Inherits="Yarmouk.CompanyPages.SectionMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>UIMS</title>
<link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>" rel="stylesheet" />
<link href="<%= ResolveUrl("~/Content/CompanyPages/shared.css") %>" rel="stylesheet" />
<link runat="server" href="~/Content/CompanyPages/sidebar.css" rel="stylesheet" />
<script src='<%= ResolveUrl("~/Scripts/CompanyPages/sidebar.js") %>' defer></script>
<asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
<form id="form1" runat="server">
<div class="yu-dashboard" data-dashboard-sidebar data-role="company" data-base-url='<%= ResolveUrl("~/") %>'>
  <svg class="yu-sidebar-symbols" aria-hidden="true" focusable="false"><defs><symbol id="ys-icon-grid" viewBox="0 0 24 24"><path d="M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h6v6h-6z"/></symbol><symbol id="ys-icon-people" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 4a4 4 0 0 1 0 8M22 21v-2a4 4 0 0 0-3-3.87M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0"/></symbol><symbol id="ys-icon-building" viewBox="0 0 24 24"><path d="M3 21V4h12v17M15 10h6v11M1 21h22M7 8h1M11 8h1M7 12h1M11 12h1M7 16h1M11 16h1M18 14h1M18 18h1"/></symbol><symbol id="ys-icon-badge" viewBox="0 0 24 24"><path d="M4 3h16v18H4zM9 2h6M15 9a3 3 0 1 1-6 0 3 3 0 0 1 6 0M7 18v-1a5 5 0 0 1 10 0v1"/></symbol><symbol id="ys-icon-diagram" viewBox="0 0 24 24"><path d="M8 2h8v6H8zM2 16h8v6H2zM14 16h8v6h-8zM12 8v4M6 16v-4h12v4"/></symbol><symbol id="ys-icon-chart" viewBox="0 0 24 24"><path d="M3 3v18h18M7 14l5-5 4 3 5-7M16 5h5v5"/></symbol><symbol id="ys-icon-check" viewBox="0 0 24 24"><path d="M9 3H5v18h14V3h-4M9 2h6v4H9zM8 13l3 3 5-6"/></symbol><symbol id="ys-icon-mail" viewBox="0 0 24 24"><path d="M2 4h20v16H2zM2 5l10 8L22 5"/></symbol><symbol id="ys-icon-briefcase" viewBox="0 0 24 24"><path d="M3 7h18v14H3zM8 7V3h8v4M3 11l9 3 9-3M10 12h4v4h-4z"/></symbol><symbol id="ys-icon-send" viewBox="0 0 24 24"><path d="M22 2 9 15M22 2l-7 20-6-7-7-6z"/></symbol><symbol id="ys-icon-tasks" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 5h1v2H3zM3 11h1v2H3zM3 17h1v2H3z"/></symbol><symbol id="ys-icon-book" viewBox="0 0 24 24"><path d="M3 3h8a3 3 0 0 1 3 3v16a4 4 0 0 0-4-3H3zM14 6a3 3 0 0 1 3-3h4v16h-3a4 4 0 0 0-4 3"/></symbol><symbol id="ys-icon-profile" viewBox="0 0 24 24"><path d="M16 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0M4 22v-3a8 8 0 0 1 16 0v3"/></symbol><symbol id="ys-icon-logout" viewBox="0 0 24 24"><path d="M9 4H3v16h6M13 7l5 5-5 5M8 12h14"/></symbol><symbol id="ys-icon-moon" viewBox="0 0 24 24"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4a9 9 0 1 0 11.5 11.5"/></symbol><symbol id="ys-icon-sun" viewBox="0 0 24 24"><path d="M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M5 19l1.5-1.5M17.5 6.5 19 5"/></symbol><symbol id="ys-icon-chevron" viewBox="0 0 24 24"><path d="M14 6l-6 6 6 6"/></symbol><symbol id="ys-icon-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol></defs></svg>
  <div class="yu-sidebar-rail">
    <aside class="yu-sidebar" id="dashboard-navigation" aria-label="Dashboard navigation">
      <header class="yu-sidebar-header">
        <a class="yu-sidebar-brand" href='<%= ResolveUrl("~/PublicPages/Home.aspx") %>' data-sidebar-home aria-label="Yarmouk University home"><img src="data:image/svg+xml;base64," alt="Yarmouk University" width="170" height="52"><img class="yu-sidebar-crest" src="data:image/svg+xml;base64," alt="Yarmouk University" width="34" height="44"></a>
        <button class="yu-sidebar-toggle" type="button" data-sidebar-toggle aria-controls="dashboard-navigation" aria-expanded="true" aria-label="Collapse navigation"><svg aria-hidden="true"><use href="#ys-icon-chevron"></use></svg></button>
      </header>
      <nav class="yu-sidebar-nav" aria-label="Workspace pages"><span class="yu-sidebar-section">Workspace</span><div class="yu-sidebar-links" data-sidebar-links><a class="yu-sidebar-link" href="Dashboard.aspx"><svg aria-hidden="true"><use href="#ys-icon-grid"></use></svg><span>Dashboard</span></a></div></nav>
      <div class="yu-sidebar-bottom">
        <span class="yu-sidebar-section">Account</span>
        <a class="yu-sidebar-profile" data-sidebar-profile href="Account.aspx" aria-label="Profile" title="Profile"><svg aria-hidden="true"><use href="#ys-icon-profile"></use></svg><span><strong data-sidebar-role>Company supervisor</strong><small>View profile</small></span></a>
        <button type="button" class="yu-sidebar-theme" data-sidebar-theme aria-label="Switch to dark mode" title="Change appearance"><svg aria-hidden="true"><use href="#ys-icon-moon"></use></svg><span>Dark mode</span></button>
        <a href="#" hidden data-sidebar-logout aria-label="Sign out" title="Sign out"><svg aria-hidden="true"><use href="#ys-icon-logout"></use></svg><span>Sign out</span></a>
        <button type="button" class="yu-sidebar-pin" data-sidebar-pin role="switch" aria-checked="false" aria-label="Keep sidebar open"><span>Keep sidebar open</span><span class="yu-sidebar-pin-track" aria-hidden="true"></span></button>
      </div>
    </aside>
  </div>
  <div class="yu-sidebar-shade" hidden aria-hidden="true"></div>
  <button type="button" class="yu-sidebar-menu" data-sidebar-menu aria-controls="dashboard-navigation" aria-expanded="false" hidden><svg aria-hidden="true"><use href="#ys-icon-menu"></use></svg><span>Menu</span></button>

  <div class="yu-dashboard-main">
<header class="container py-3 border-bottom"><a href="<%= ResolveUrl("~/Default.aspx") %>">UIMS</a> <span class="ms-3">Company</span></header>
<main class="container py-4"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
<footer class="container py-3 border-top"><small>UIMS - University Internship Management System</small></footer>
  </div>
</div>
</form>
</body>
</html>
